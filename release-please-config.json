{
  "pull-request-title-pattern": "chore: release s2-sdk ${version}",
  "packages": {
    ".": {
      "release-type": "python",
      "package-name": "s2-sdk",
      "bump-minor-pre-major": true,
      "include-component-in-tag": false,
      "extra-files": [
        "docs/source/conf.py",
        {
          "type": "toml",
          "path": "uv.lock",
          "jsonpath": "$.package[?(@.name.value=='s2-sdk')].version"
        }
      ]
    }
  }
}
